# Copy to .env to change the defaults. Everything here is optional.

# Address and port the web UI listens on (host side).
# 0.0.0.0 = reachable from the local network; 127.0.0.1 = this machine only.
BIND_ADDRESS=0.0.0.0
PORT=8095

# Password for the web UI (any username). Leave empty to use a random password that is
# generated on first start into data/ui-password (show it with `make password`).
# Anyone with this password can run commands as root on this machine: make it long.
UI_PASSWORD=
